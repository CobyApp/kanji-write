# Fastlane lanes for マイカンジ / MyKanji.
#
# * `test`  — regenerate the Tuist project and run the whole test suite.
# * `beta`  — archive Release and upload the build to TestFlight.
#
# Signing is automatic (CODE_SIGN_STYLE = Automatic in Project.swift). On CI
# there is no interactive account, so an App Store Connect API key authenticates
# and `-allowProvisioningUpdates` lets Xcode create/download the distribution
# certificate and the app/widget/watch provisioning profiles on the fly. No
# fastlane match repo is required. (If cloud signing ever proves flaky, switch
# to match — see docs/ci-deploy.md.)
#
# Required env vars for `beta` (set as GitHub Secrets — see docs/ci-deploy.md):
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8 (base64 of the .p8), RELEASE_VERSION

default_platform(:ios)

WORKSPACE = "KanjiWrite.xcworkspace"
APP_SCHEME = "KanjiApp"
TEST_SCHEME = "KanjiWrite"
APP_IDENTIFIER = "com.cobyapp.kanjiwrite"

# Regenerate the workspace from Project.swift. `sh` runs in fastlane/, and the
# script cd's to app/ itself, so the relative path is all it needs.
def generate_project
  sh("../Scripts/generate.sh")
end

platform :ios do
  desc "Regenerate the project and run the test suite"
  lane :test do
    generate_project
    run_tests(
      workspace: WORKSPACE,
      scheme: TEST_SCHEME,
      # Adjust to a simulator the runner's Xcode actually has.
      devices: ["iPhone 17 Pro"],
      result_bundle: true
    )
  end

  desc "Archive Release and upload to TestFlight"
  lane :beta do
    require "base64"
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")
    # Decode the base64 .p8 to a file so xcodebuild's authentication flags can
    # point at it for cloud signing. Gitignored (*.p8) and the runner is
    # ephemeral, so it never persists.
    key_path = File.expand_path("asc_authkey.p8", __dir__)
    File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_P8")))

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path
    )

    generate_project

    # Build number = one past the highest already on TestFlight for this
    # marketing version, so re-runs never collide. Passed as an xcarg because
    # Tuist regenerates the project (any Info.plist edit would be overwritten).
    version = ENV.fetch("RELEASE_VERSION")
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      version: version,
      initial_build_number: 0
    )
    build_number = latest + 1
    UI.message("Building #{version} (#{build_number}) for TestFlight")

    # gym takes no api_key; automatic ("cloud") signing needs the App Store
    # Connect key handed to xcodebuild directly, on both the archive and the
    # export steps, alongside -allowProvisioningUpdates.
    auth = "-authenticationKeyID #{key_id} " \
           "-authenticationKeyIssuerID #{issuer_id} " \
           "-authenticationKeyPath #{key_path}"
    build_app(
      workspace: WORKSPACE,
      scheme: APP_SCHEME,
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates #{auth} CURRENT_PROJECT_VERSION=#{build_number}",
      export_xcargs: "-allowProvisioningUpdates #{auth}",
      output_directory: "build",
      clean: true
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true # don't hold the runner while Apple processes
    )
  end
end
