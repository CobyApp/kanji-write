# macOS
.DS_Store

# Data pipeline: raw downloaded datasets (fetched by script, not versioned).
# Ignore everything in sources/ EXCEPT the curated LLM gloss file (see bottom).
data-pipeline/sources/*

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/

# Data pipeline build output (generated artifact)
data-pipeline/out/

# Xcode / SwiftPM
app/.build/
app/DerivedData/
*.xcuserstate
xcuserdata/

# Tuist / Xcode generated (manifests are committed; generated projects are not)
app/*.xcodeproj
app/*.xcworkspace
app/Derived/
app/Tuist/.build/

# LLM-generated native glosses are curated output (not re-downloadable, non-deterministic) — keep them
!data-pipeline/sources/llm_glosses.jsonl
!data-pipeline/sources/word_glosses_ko.jsonl
!data-pipeline/sources/word_glosses_jazh.jsonl
!data-pipeline/sources/sentence_glosses.jsonl
# Agent-authored JLPT question bank (curated output) — keep it
!data-pipeline/sources/jlpt_questions.jsonl
# Curated verified glyph manifest and deterministic pending report
!data-pipeline/sources/kanken_glyph_map.csv
!data-pipeline/sources/kanken_glyph_candidates.csv
# Reviewer decision sheet for the image-only variants. The probe JSON and the
# fetched SVGs stay untracked — the manifest pins revision + sha256, so both are
# reproducible from it.
!data-pipeline/sources/kanken_glyph_review.csv

# Local scratch (question-generation batches, temp scripts) — never commit
scratch/
!data-pipeline/sources/kanken_advanced_questions.jsonl
